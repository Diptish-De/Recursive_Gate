# Copy this file to .env.local and fill it in. .env.local is never committed.

# Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=paste-your-key-here

# Models. Rate limits are per model, so these are deliberately different.
# Run `npm run check:gemini` to confirm the agent model answers.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
CLAIMS_MODEL=gemini-3.5-flash-lite
